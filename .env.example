# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alpha_radar

# Robinhood chain RPC endpoints
RH_RPC_HTTP=
RH_RPC_WS=

# New-token launch contracts (Robinhood Mainnet, chainId 4663)
DOPPLER_AIRLOCK_ADDRESS=0xeb7c034704ef8dcd2d32324c1545f62fb4ad0862
PONS_V1_FACTORY_ADDRESS=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB

# Telegram alerts (Phase 8 — the primary alert channel). Without both set,
# alerting is disabled entirely (logged once at startup). Layered by
# importance score: <7.0 nothing, 7.0-7.9 normal, 8.0-8.9 STRONG, >=9.0 URGENT.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (Resend) — retained but OFF by default. Set all three to also
# send the full HTML report by email alongside every Telegram alert.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Admin API access
ADMIN_API_KEY=

# Mobula API (wallet verification, scripts/verifyWallets.ts). Optional —
# without it, falls back to Mobula's public demo API (rate-limited).
# Get a free key at https://admin.mobula.io/
MOBULA_API_KEY=

# Candidate tracker tuning (all optional — see market/candidateTrackerLogic.ts for defaults)
CANDIDATE_ACTIVE_REFRESH_MS=
CANDIDATE_INACTIVE_REFRESH_MS=
CANDIDATE_MIN_TRACKING_HOURS=
CANDIDATE_EXIT_INACTIVITY_HOURS=

# KOL resonance detection tuning (optional — see signals/resonanceLogic.ts for defaults)
RESONANCE_WINDOW_MINUTES=
RESONANCE_COOLDOWN_MINUTES=

# Outcome tracker (Phase 9, optional — defaults in outcomes/outcomeTrackerLogic.ts).
# OUTCOME_SWEEP_INTERVAL_MS: how often the sweeper checks for due points (default 30000).
# OUTCOME_OFFSETS_MS: 5 comma-separated ms values for the +5m/+15m/+1h/+6h/+24h
#   samples — ONLY for shortening the schedule during a live pipeline test.
OUTCOME_SWEEP_INTERVAL_MS=
OUTCOME_OFFSETS_MS=

# App
LOG_LEVEL=info
PORT=3000
