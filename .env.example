# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alpha_radar

# Robinhood chain RPC endpoints
RH_RPC_HTTP=
RH_RPC_WS=

# New-token launch contracts (Robinhood Mainnet, chainId 4663)
DOPPLER_AIRLOCK_ADDRESS=0xeb7c034704ef8dcd2d32324c1545f62fb4ad0862
PONS_V1_FACTORY_ADDRESS=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB

# Email alerts (Resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin API access
ADMIN_API_KEY=

# Mobula API (wallet verification, scripts/verifyWallets.ts). Optional —
# without it, falls back to Mobula's public demo API (rate-limited).
# Get a free key at https://admin.mobula.io/
MOBULA_API_KEY=

# Candidate tracker tuning (all optional — see market/candidateTrackerLogic.ts for defaults)
CANDIDATE_ACTIVE_REFRESH_MS=
CANDIDATE_INACTIVE_REFRESH_MS=
CANDIDATE_MIN_TRACKING_HOURS=
CANDIDATE_EXIT_INACTIVITY_HOURS=

# KOL resonance detection tuning (optional — see signals/resonanceLogic.ts for defaults)
RESONANCE_WINDOW_MINUTES=
RESONANCE_COOLDOWN_MINUTES=

# App
LOG_LEVEL=info
PORT=3000
